[sub_resource type="GDScript" id="GDScript_5qtum"]
resource_name = "Intro_cutscene"
script/source = "extends AnimationPlayer

@export var debug = false
@export var debug_skip_cutscene = true
const INTRO_CUTSCENE_PART_1 = \"res://assets/Story/intro_cutscene/intro_cutscene_part_1.json\"
const INTRO_CUTSCENE_PART_2 = \"res://assets/Story/intro_cutscene/intro_cutscene_part_2.json\"
const INTRO_CUTSCENE_PART_3 = \"res://assets/Story/intro_cutscene/intro_cutscene_part_3.json\"
const INTRO_CUTSCENE_PART_4 = \"res://assets/Story/intro_cutscene/intro_cutscene_part_4.json\"
var tween

@onready var questmarkers: Node3D = $\"../../../GridMapHelper/Questmarkers/windmills_builds_quests\"
@onready var intro_camera: Camera3D = $animation_helper/intro_camera

@onready var gui: Control = $\"../../../GUI\"
@onready var camera: Camera3D = $\"../../../Camera\"

#@onready var camera: Camera3D = $\"../../../../Camera\"
#@onready var gui: Control = $\"../../../../GUI\"
@onready var transition_fade: ColorRect = $CanvasLayer/transition_fade


func _ready() -> void:
	#prep work
	#Conversation.choice_made.connect(_windmill_choice_selected)
	transition_fade.modulate.a = 1
	cutscene_visible(true)
	if debug_skip_cutscene:
		camera.current = true
		cutscene_visible(false)
		await  get_tree().create_timer(1).timeout
		windmill_quest_markers(true)
		#build_windmill_cutscene()
		return
	if debug:
		self.speed_scale = 100
	#prep work

	windmill_quest_markers(false)
	intro_camera.current = true
	ConversationManager.visible = false
	GameController.allow_highlighter_move = false
	gui.visible =false
	transition_fade.visible = true
	await get_tree().create_timer(1).timeout
	
	# part 1: ship travels to harbor 
	self.play(\"Intro_cutscene\")
	await self.animation_finished
	print(\"animation finsihed\")
	
	# part 2: welcoming dialogue
	ConversationManager.visible = true
	print(\"starting dialogue\")
	await ConversationManager._start_dialogue(ConversationManager._load_dialogue_json(INTRO_CUTSCENE_PART_1))
	#pan around the city
	print(\"playing conversation part 2\")
	self.play(\"intro_cutscene_2\")
	await ConversationManager._start_dialogue(ConversationManager._load_dialogue_json(INTRO_CUTSCENE_PART_2))
	if self.is_playing():
		await self.animation_finished

	# pan towards the townhall and talk there
	#self.speed_scale = 1 
	self.play(\"intro_cutscene_3\")
	await self.animation_finished
	await ConversationManager._start_dialogue(ConversationManager._load_dialogue_json(INTRO_CUTSCENE_PART_3))
	#showing windmill build sites
	windmill_quest_markers(true)
	#panning to ramsar sites to show point of interest 
	ConversationManager._start_dialogue(ConversationManager._load_dialogue_json(INTRO_CUTSCENE_PART_4))
	tween = create_tween()
	tween.tween_property(intro_camera,\"size\",100,1)
	await tween.finished
	await get_tree().create_timer(1).timeout
	#tween = create_tween()
	## pan to the shore point of interest
	#tween.tween_property(intro_camera,\"position\",Vector3(-80,119,-561),0.7)
	#await tween.finished
	#await get_tree().create_timer(1).timeout
	
	tween = create_tween()
	tween.tween_property(intro_camera,\"position\",Vector3(-186,123.832,-483.12),0.7)
	await tween.finished
	intro_camera.current = false
	camera.global_position = intro_camera.global_position
	GameController.allow_highlighter_move = true
	camera.current = true
	gui.visible = true
	cutscene_visible(false)
	self.speed_scale = 1
	
func cutscene_visible(debounce :bool):
	for child in find_children(\"*\"):
		child.visible = debounce

#part 2 windmill
func build_windmill_cutscene():
	while true:
		var button_chosen = await ConversationManager.wait_for_choice()
		if button_chosen.text != \"no\":
			for c in questmarkers.get_children():
				c.queue_free()
			print(\"building windmills transition\")
			gui.visible = false
			cutscene_visible(true)
			self.play(\"windmill_construction_transition\")
			await animation_finished
			gui.visible = true
			cutscene_visible(false)
			break

func windmill_quest_markers(debounce :bool):
	questmarkers.visible = debounce
	for c in questmarkers.get_children():
		if c.name != \"ramsar\" and c.name != \"shore\": # remove later, for now this
			c.visible =	 debounce
	
"

[sub_resource type="GDScript" id="GDScript_ie368"]
resource_name = "Center_container"
script/source = "extends CenterContainer


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	self.pivot_offset = Vector2(self.size.x /2,self.size.y/2)
	pass # Replace with function body.
"

