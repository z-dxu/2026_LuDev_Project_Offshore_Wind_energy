[sub_resource type="GDScript" id="GDScript_x5dfk"]
resource_name = "outro"
script/source = "extends AnimationPlayer

const OUTRO_PART_1 = \"res://assets/Story/outro_cutscence/outro_part_1.json\"
const OUTRO_PART_2 = \"res://assets/Story/outro_cutscence/outro_part_2.json\"
@onready var center_container: CenterContainer = $animation_helper/CenterContainer
@onready var transition_fade: ColorRect = $animation_helper/transition_fade
@onready var animation_helper: Node3D = $animation_helper
@onready var grid_map: GridMap = $\"../../../GridMap\"
@onready var questmarkers: Node3D = $\"../../../GridMapHelper/Questmarkers\"

@onready var label: Label = $animation_helper/CenterContainer/Label
@onready var outro_camera: Camera3D = $animation_helper/outro_camera
@onready var gui: Control = $\"../../../GUI\"
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	for c in self.get_children():
		c.visible = false
	transition_fade.visible = false
func play_outro():
	#prep for animation
	animation_helper.visible = true
	GameController.allow_highlighter_move = false
	grid_map.position = Vector3(0,0,0) # prevent animation being played wrpmgly
	gui.visible = false
	animation_helper.position = Vector3(-159.5,0,41)
	outro_camera.position = Vector3(303.278,75.701,-151.154)
	questmarkers.visible = false
	self.play(\"outro_part_1\")
	await self.animation_finished
	
	# concluding the session
	ConversationManager.visible = true
	print(\"starting dialogue\")
	await ConversationManager._start_dialogue(ConversationManager._load_dialogue_json(OUTRO_PART_1))
	
	self.play(\"outro_part_2\")
	await self.animation_finished
	ConversationManager.visible = true
	print(\"starting dialogue\")
	await ConversationManager._start_dialogue(ConversationManager._load_dialogue_json(OUTRO_PART_2))
	
	label.text = GameController.story_flags.get(\"ending\",\"\")
	self.play(\"outro_part_3\")
	self.speed_scale= 2
	await self.animation_finished
	SceneTransition.change_scene(\"res://Scenes/ending.tscn\")
	
"

